[user]
	name = QriLa
	email = rea9lizer@gmail.com
[init]
	defaultBranch = main

[core]
	editor = hx
	autocrlf = false
	eol = lf
{{- if eq .chezmoi.os "windows"}}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end}}

[fetch]
	prune = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
	autoUpdate = false

[credential]
{{- if ne .chezmoi.os "windows"}}
	helper = !gh auth git-credential
{{- else}}
	helper = !C:/Users/Hyeon/scoop/apps/git/current/mingw64/bin/git-credential-manager.exe
[gpg.ssh]
	program = "C:/Windows/System32/OpenSSH/ssh-keygen.exe"
[safe]
	directory = C:/Users/Hyeon/scoop/apps/scoop/current/*
[windows]
	appendAtomically = false
{{- end}}
